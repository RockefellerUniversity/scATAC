.DS_Store
.gitignore
r_course/

# Course data: the 10x PBMC 500 inputs are downloaded at render time (CI step
# "Download course data") and the .rds checkpoints are regenerated by Session 2.
# Never commit them — the fragment file alone exceeds GitHub's 100 MB limit.
docs/data/atac_pbmc_500_nextgem_*
# Label-transfer reference (Session 3), ~172 MB: downloaded in CI, never committed.
docs/data/pbmc_10k_rna.rds
# Session 3 -> Session 4 checkpoint, ~131 MB: regenerated during the render, never committed.
docs/data/pbmc_annotated.rds
# Session 2 exercise data (10x E18 mouse brain, flash-frozen; fragments ~1.1 GB):
# downloaded in CI, never committed. The filtered checkpoint is regenerated by the render.
docs/data/atac_v1_E18_brain_flash_5k_*
docs/data/brain_filtered_tfidf.rds
# Two-sample pseudobulk data (built locally by docs/notebooks/dataset2_prep.R):
# multiome fragments (2 GB full + per-cell subset) and the PBMC 500 peak calls.
docs/data/pbmc_multiome_full_fragments.tsv.gz*
docs/data/pbmc_multiome_fragments.tsv.gz*
docs/data/atac_pbmc_500_nextgem_peaks.bed
# Session 3 exercise label-transfer reference (Allen adult mouse cortex, ~1.16 GB):
# downloaded in CI, never committed.
docs/data/allen_brain.rds
# Session 3 -> Session 4 exercise checkpoint, regenerated by the render.
docs/data/brain_annotated.rds
# Exercise data copied next to the exercises for rendering (multi-GB): never commit.
docs/exercises/data/
# Session 4 two-sample objects (~230 MB): downloaded in CI / built by dataset2_prep.R, never committed.
docs/data/pbmc_integrated.rds
docs/data/pbmc_multiome.rds
